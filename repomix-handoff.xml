  <!-- ═══════════════════════════════════════════════════════
       MODAL GENÉRICO (CRUD, confirmações, detalhes)
       ═══════════════════════════════════════════════════════ -->
  <div class="modal-overlay" id="modalOverlay">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
      <div class="modal-header">
