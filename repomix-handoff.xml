      tbody.innerHTML = State.logs.dados.map(l => `
        <tr>
          <td>${UI.formatarDataHora(l.data_hora)}</td>
          <td>${l.usuario}</td>
          <td>${l.acao}</td>
          <td>${l.tabela}</td>
          <td>${l.registro || '—'}</td>
