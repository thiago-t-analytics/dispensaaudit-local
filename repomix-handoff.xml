/*
 * DESIGN SYSTEM — BASE
 * O que faz: normaliza medidas, melhora legibilidade e define estilos globais
 * de foco e movimento reduzido sem alterar IDs/classes usados pela aplicação.
 * Por que: os componentes partem de uma base previsível e acessível.
 * Teste visual: use Tab para percorrer a tela e confirme o contorno visível;
 * habilite "reduzir movimento" no sistema e navegue entre páginas.
 */
*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  min-width: 320px;
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: var(--line-height-normal);
  text-size-adjust: 100%;
  -webkit-text-size-adjust: 100%;
  scroll-behavior: smooth;
}

body {
  min-height: 100vh;
  margin: 0;
  background-color: var(--surface-canvas);
  color: var(--text-primary);
  font-family: var(--font-sans);
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-regular);
  line-height: var(--line-height-normal);
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
}

button,
input,
select,
textarea {
  color: inherit;
  font: inherit;
}

button,
select {
  cursor: pointer;
}

button:disabled,
select:disabled,
input:disabled,
textarea:disabled {
  cursor: not-allowed;
}

img,
svg,
canvas {
  max-width: 100%;
}

table {
  border-spacing: 0;
}

::selection {
  background: var(--color-primary-100);
  color: var(--color-primary-700);
}

:focus {
  outline: none;
}

:focus-visible {
  outline: 2px solid var(--color-primary-600);
  outline-offset: 2px;
  box-shadow: var(--shadow-focus);
}

/* Compatível com navegação de teclado; será usado pelo layout atualizado. */
.skip-link {
  position: fixed;
  top: var(--space-2);
  left: var(--space-2);
  z-index: 10000;
  padding: var(--space-2) var(--space-4);
  transform: translateY(calc(-100% - var(--space-2)));
  border-radius: var(--radius-md);
  background: var(--surface-inverse);
  color: var(--surface-default);
  font-weight: var(--font-weight-semibold);
}

.skip-link:focus {
  transform: translateY(0);
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
