/* 
 * DESIGN SYSTEM — TOKENS
 * O que faz: centraliza as decisões visuais em propriedades reutilizáveis.
 * Por que: uma paleta e uma escala únicas evitam diferenças entre telas e
 * facilitam ajustes futuros sem procurar valores espalhados pelo CSS.
 * Teste visual: altere --color-primary e recarregue para ver a cor de ação
 * refletida nos componentes que consomem os tokens.
 */
:root {
  color-scheme: light;

  /* Azul-petróleo e verde-sálvia: identidade de saúde com calor humano. */
  --color-primary-700: #0f4c5c;
  --color-primary-600: #1a6b7f;
  --color-primary-500: #267f91;
  --color-primary-100: #e5f1f2;
  --color-secondary-700: #3e7464;
  --color-secondary-600: #568b78;
  --color-secondary-500: #6ba292;
  --color-secondary-100: #eaf3ef;

  /* Dez neutros quentes, do quase branco ao carvão. */
  --color-neutral-0: #ffffff;
  --color-neutral-50: #fafaf7;
  --color-neutral-100: #f3f3ee;
  --color-neutral-200: #e7e7e0;
  --color-neutral-300: #d3d4cc;
  --color-neutral-400: #a7aaa2;
  --color-neutral-500: #777c75;
  --color-neutral-600: #5b615b;
  --color-neutral-700: #424943;
  --color-neutral-800: #2b332f;
  --color-neutral-900: #1a2420;

  /* Tons semânticos escuros mantêm boa leitura sobre superfícies claras. */
  --color-success: #287a55;
  --color-success-soft: #e8f4ed;
  --color-warning: #895b08;
  --color-warning-soft: #fbf1d9;
  --color-error: #b42332;
  --color-error-soft: #fbeaec;
  --color-info: #216a85;
  --color-info-soft: #e8f2f6;

  --surface-canvas: var(--color-neutral-50);
  --surface-default: var(--color-neutral-0);
  --surface-raised: #ffffff;
  --surface-sunken: var(--color-neutral-100);
  --surface-inverse: var(--color-neutral-900);
  --text-primary: var(--color-neutral-900);
  --text-secondary: var(--color-neutral-600);
  --text-muted: var(--color-neutral-500);
  --text-on-primary: #ffffff;
  --border-default: var(--color-neutral-200);
  --border-strong: var(--color-neutral-300);

  /* Compatibilidade temporária com os nomes usados por style.css. */
  --primary: var(--color-primary-700);
  --primary-light: var(--color-primary-600);
  --secondary: var(--color-secondary-500);
  --success: var(--color-success);
  --success-light: var(--color-success-soft);
  --info: var(--color-info);
  --warning: #b77912;
  --warning-light: var(--color-warning-soft);
  --danger: var(--color-error);
  --danger-light: var(--color-error-soft);
  --gray-50: var(--color-neutral-50);
  --gray-100: var(--color-neutral-100);
  --gray-200: var(--color-neutral-200);
  --gray-300: var(--color-neutral-300);
  --gray-500: var(--color-neutral-500);
  --gray-600: var(--color-neutral-600);
  --gray-700: var(--color-neutral-700);
  --gray-900: var(--color-neutral-900);
  --text: var(--text-primary);

  /* Família do sistema: rápida, legível e sem dependência de fonte externa. */
  --font-sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
    "Segoe UI", sans-serif;
  --font-mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;

  /* Escala tipográfica de sete tamanhos para hierarquia consistente. */
  --font-size-xs: 0.75rem;
  --font-size-sm: 0.875rem;
  --font-size-md: 1rem;
  --font-size-lg: 1.125rem;
  --font-size-xl: 1.25rem;
  --font-size-2xl: 1.5rem;
  --font-size-3xl: 1.875rem;
  --font-weight-regular: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;
  --line-height-tight: 1.25;
