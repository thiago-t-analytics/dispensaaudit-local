# ─────────────────────────────────────────────────────────────
# ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE
# ─────────────────────────────────────────────────────────────
# Copie este arquivo para `.env` e ajuste os valores se necessário.
# O arquivo `.env` NÃO vai para o Git (está no .gitignore).
# ─────────────────────────────────────────────────────────────

# Porta do servidor
PORT=3000

# Caminho do banco de dados (relativo à raiz do projeto)
DB_PATH=./database/dispensaaudit.db

# Nome exibido na interface
APP_NAME=DispensaAudit Local

# Ambiente (development | production)
NODE_ENV=development